{
  "name": "sandstrike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "build:e2e": "vite build --mode e2e",
    "build:e2e:pages": "vite build --mode e2e-pages",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test --config=playwright.pages.config.ts",
    "test:smoke:root": "playwright test --config=playwright.production.config.ts",
    "test:smoke:pages": "playwright test --config=playwright.production-pages.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
